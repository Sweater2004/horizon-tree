"""
SNMP-опрос устройств.
Получает: sysName, sysDescr, sysUpTime, sysLocation.
Работает на Astra Linux (порт 161 UDP).
"""
from typing import Optional, Dict


# Стандартные OID
OID_SYS_NAME = "1.3.6.1.2.1.1.5.0"      # sysName
OID_SYS_DESCR = "1.3.6.1.2.1.1.1.0"     # sysDescr
OID_SYS_UPTIME = "1.3.6.1.2.1.1.3.0"    # sysUpTime
OID_SYS_LOCATION = "1.3.6.1.2.1.1.6.0"  # sysLocation
OID_SYS_CONTACT = "1.3.6.1.2.1.1.4.0"   # sysContact


def snmp_get(
    ip: str,
    community: str = "public",
    version: str = "2c",
    timeout: int = 3,
    retries: int = 1
) -> Optional[Dict]:
    """
    SNMP GET для базовых OID (sysName, sysDescr, sysUpTime, sysLocation).
    
    Возвращает:
        {
            "name": "...",
            "descr": "...",
            "uptime": "...",
            "location": "...",
            "contact": "..."
        }
        или None при ошибке.
    """
    try:
        from pysnmp.hlapi import (
            getCmd, SnmpEngine, CommunityData, UdpTransportTarget,
            ContextData, ObjectType, ObjectIdentity
        )
    except ImportError:
        print("⚠️ pysnmp не установлен, SNMP пропущен")
        return None

    oids = {
        "name": OID_SYS_NAME,
        "descr": OID_SYS_DESCR,
        "uptime": OID_SYS_UPTIME,
        "location": OID_SYS_LOCATION,
        "contact": OID_SYS_CONTACT,
    }

    try:
        # Формируем запрос на все OID сразу
        object_types = [ObjectType(ObjectIdentity(oid)) for oid in oids.values()]

        iterator = getCmd(
            SnmpEngine(),
            CommunityData(community, mpModel=1 if version == "2c" else 0),
            UdpTransportTarget((ip, 161), timeout=timeout, retries=retries),
            ContextData(),
            *object_types
        )

        error_indication, error_status, error_index, var_binds = next(iterator)

        if error_indication:
            # Таймаут или хост недоступен — это норма для устройств без SNMP
            return None

        if error_status:
            return None

        result = {}
        for key, var_bind in zip(oids.keys(), var_binds):
            value = var_bind[1]
            result[key] = str(value) if value else ""

        # Фильтруем "noSuchObject" / "noSuchInstance"
        for key in result:
            if result[key] in ("No Such Object currently exists at this OID",
                               "No Such Instance currently exists at this OID"):
                result[key] = ""

        return result

    except Exception as e:
        print(f"⚠️ SNMP ошибка для {ip}: {e}")
        return None


def format_uptime(ticks_str: str) -> str:
    """Преобразует sysUpTime (ticks) в человеко-читаемый формат."""
    try:
        ticks = int(ticks_str)
        seconds = ticks // 100
        days = seconds // 86400
        hours = (seconds % 86400) // 3600
        minutes = (seconds % 3600) // 60
        parts = []
        if days: parts.append(f"{days}д")
        if hours: parts.append(f"{hours}ч")
        if minutes: parts.append(f"{minutes}м")
        return " ".join(parts) if parts else "только что"
    except (ValueError, TypeError):
        return ticks_str or "—"


def enrich_node_metadata(node: dict, community: str = "public") -> dict:
    """
    Обогащает узел SNMP-данными, если устройство отвечает.
    Модифицирует node["metadata"] и node["name"].
    """
    ip = node.get("ip")
    if not ip:
        return node

    result = snmp_get(ip, community=community, timeout=2, retries=1)
    if not result:
        return node

    meta = node.get("metadata", {}) or {}
    if result.get("descr"):
        meta["snmp_descr"] = result["descr"]
        # Пытаемся вытащить vendor/model из sysDescr
        # Пример: "Cisco IOS Software, C2960 Software..."
        descr = result["descr"]
        if descr:
            # Берём первые слова как vendor
            words = descr.split()
            if words:
                meta["vendor"] = words[0]
    if result.get("uptime"):
        meta["snmp_uptime"] = format_uptime(result["uptime"])
    if result.get("location"):
        meta["snmp_location"] = result["location"]
    if result.get("contact"):
        meta["snmp_contact"] = result["contact"]

    node["etadata"] = meta
    node["discovered_by"] = list(set(node.get("discovered_by", []) + ["snmp"]))

    # Если sysName есть и узел 
